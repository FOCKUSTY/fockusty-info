{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "payment": { "type": "string" }
      },
      "required": ["name", "description", "payment"],
      "additionalProperties": false
    }
  }
}
